# Ustaw zmienne w powłoce uruchamiającej CLI lub backend:
# set -a; source llm.env.example; set +a
LLM_PROVIDER=llama.cpp
# Zalecany (82% na zbiorze testowym): polski Bielik-11B v2.6, ~6,7 GB, pobierany automatycznie z przypiętej wersji.
LLM_MODEL=bielik-11b-v2.6-instruct
# Mac z Apple Silicon: -1 = wszystkie warstwy na GPU (Metal), ok. 6 s na fragment. 0 = tylko CPU (wolniej).
LLM_GPU_LAYERS=-1
# Lżejszy (56%, ~1,1 GB, domyślny w kontenerze): LLM_MODEL=qwen2.5-1.5b-instruct, LLM_GPU_LAYERS=0
# Opcjonalnie ustaw LLM_MODEL_PATH na ścieżkę do własnego pliku GGUF.

# Alternatywy:
# LLM_PROVIDER=ollama
# LLM_MODEL=<model-dostępny-w-Ollamie>
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# LLM_PROVIDER=anthropic
# LLM_MODEL=<model-dostępny-na-koncie>
# LLM_API_KEY ustaw w środowisku backendu.
