# Ustaw zmienne w powłoce uruchamiającej CLI lub backend:
# set -a; source llm.env.example; set +a
LLM_PROVIDER=llama.cpp
LLM_MODEL=qwen2.5-1.5b-instruct
LLAMA_BASE_URL=http://127.0.0.1:8081

# Alternatywy:
# LLM_PROVIDER=ollama
# LLM_MODEL=<model-dostępny-w-Ollamie>
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# LLM_PROVIDER=anthropic
# LLM_MODEL=<model-dostępny-na-koncie>
# LLM_API_KEY ustaw w środowisku backendu.
