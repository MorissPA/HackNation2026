# Ustaw zmienne w powłoce uruchamiającej CLI lub backend:
# set -a; source llm.env.example; set +a
LLM_PROVIDER=llama.cpp
# Domyślny model: polski Bielik-11B v2.6 Instruct (81,6% na zbiorze testowym), ~6,7 GB, pobierany automatycznie
# z przypiętej wersji i sprawdzany SHA-256.
LLM_MODEL=bielik-11b-v2.6-instruct
# GPU: domyślnie -1 (Metal) na Macu z Apple Silicon, 0 (CPU) gdzie indziej. Na CPU analiza jest kilka razy wolniejsza.
# LLM_GPU_LAYERS=-1
# Opcjonalnie ustaw LLM_MODEL_PATH na ścieżkę do własnego pliku GGUF.

# Alternatywy:
# LLM_PROVIDER=ollama
# LLM_MODEL=<model-dostępny-w-Ollamie>
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# LLM_PROVIDER=anthropic
# LLM_MODEL=<model-dostępny-na-koncie>
# LLM_API_KEY ustaw w środowisku backendu.
